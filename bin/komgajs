#!/usr/bin/env sh
# Lance KomgaJS (équivalent de `java -jar komga.jar`). Arguments Spring : --server.port=25600 --komga.config-dir=...
# MALLOC_ARENA_MAX=2 : limite la fragmentation de glibc avec les threads natifs (libvips), gros gain de RAM.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"
# Fuseau horaire par défaut comme la JVM sous Linux : TZ, sinon /etc/timezone, sinon /etc/localtime.
# Node ignore /etc/timezone ; Komga stocke des LocalDateTime dans ce fuseau (dates des fichiers comprises).
if [ -z "$TZ" ] && [ -r /etc/timezone ]; then
  TZ="$(tr -d ' \n' < /etc/timezone)"
  [ -n "$TZ" ] && export TZ
fi
# Limite du tas V8 de chaque thread (serveur HTTP, worker des tâches) quand la mémoire du conteneur est limitée
# (cgroup v2 ou v1) : comme la JVM (MaxRAMPercentage = 25 %), un quart de la limite, au moins 256 Mo. Deux tas
# (le worker n'existe que pendant les tâches) plus la mémoire native (SQLite, libvips, index de recherche hors tas)
# doivent tenir dans le conteneur. 256 Mo suffisent à reconstruire l'index de 50 000 livres (192 Mo mesurés).
# KOMGAJS_MAX_HEAP_MB impose la valeur explicitement.
HEAP_MB="${KOMGAJS_MAX_HEAP_MB:-}"
if [ -z "$HEAP_MB" ]; then
  LIMIT=""
  if [ -r /sys/fs/cgroup/memory.max ]; then LIMIT="$(cat /sys/fs/cgroup/memory.max)"
  elif [ -r /sys/fs/cgroup/memory/memory.limit_in_bytes ]; then LIMIT="$(cat /sys/fs/cgroup/memory/memory.limit_in_bytes)"; fi
  case "$LIMIT" in
    ''|max|*[!0-9]*) ;;
    *) if [ "$LIMIT" -lt 1099511627776 ]; then HEAP_MB=$((LIMIT / 1048576 / 4)); [ "$HEAP_MB" -lt 256 ] && HEAP_MB=256; fi ;;
  esac
fi
HEAP_OPT=""
[ -n "$HEAP_MB" ] && HEAP_OPT="--max-old-space-size=$HEAP_MB"
# --expose-gc : ramasse-miettes complet quand le pool de tâches devient inactif (src/port/spring-boot-application.ts)
# KOMGAJS_NODE_OPTIONS : options supplémentaires de Node / V8, ajoutées après celles-ci (la dernière l'emporte)
exec node --expose-gc --max-semi-space-size=4 $HEAP_OPT $KOMGAJS_NODE_OPTIONS "$DIR/dist/src/main.js" "$@"
